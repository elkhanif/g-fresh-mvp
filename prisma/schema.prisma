// G-Fresh — skema data MVP (fase pilot)
// Postgres (Supabase). URL pooled untuk runtime, DIRECT_URL untuk migrate/db push.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------
// Peran & pengguna
// ------------------------------------------------------------------

enum Role {
  PRODUSEN // petani / petambak / peternak / UMKM olahan
  KONSUMEN // rumah tangga B2C & vendor katering B2B
  KURIR // mitra logistik hyperlocal
  ADMIN // operator aplikasi (badan usaha swasta)
  PEMKAB // dinas terkait — read-only dashboard agregat
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String // bcrypt hash — BUKAN enkripsi reversibel
  role         Role
  kecamatan    String? // wilayah pilot (mis. "Kebomas", "Manyar", "Cerme")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  producer     ProducerProfile?
  courier      CourierProfile?
  orders       Order[]          @relation("ConsumerOrders")
  complaints   Complaint[]
  hetSet       HetPrice[]       @relation("HetSetBy")

  @@index([role])
}

model ProducerProfile {
  id          String            @id @default(cuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName    String
  kecamatan   String
  // Koordinat lokasi produksi. Disimpan penuh untuk pickup kurir,
  // tapi HANYA level kecamatan yang diekspos ke publik (privasi produsen).
  latitude    Float?
  longitude   Float?
  // Sertifikasi diverifikasi MANUAL oleh dinas pada fase pilot.
  certStatus  CertStatus        @default(BELUM_DIAJUKAN)
  certType    String? // "Halal" | "P-IRT" | "BPOM"
  certNote    String?
  ratingScore Float             @default(5)
  products    Product[]
  createdAt   DateTime          @default(now())
}

enum CertStatus {
  BELUM_DIAJUKAN
  MENUNGGU_VERIFIKASI
  TERVERIFIKASI
  DITOLAK
}

model CourierProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kecamatan   String
  vehicle     String? // "Motor + cool-box"
  ktpVerified Boolean  @default(false)
  active      Boolean  @default(true)
  ratingScore Float    @default(5)
  orders      Order[]  @relation("CourierOrders")
  createdAt   DateTime @default(now())
}

// ------------------------------------------------------------------
// Katalog & HET
// ------------------------------------------------------------------

model Category {
  id       String    @id @default(cuid())
  name     String    @unique // "Sayur", "Ikan", "Daging Ayam", "Beras"
  unit     String // satuan default: "kg", "ikat", "ekor"
  products Product[]
  het      HetPrice[]
}

// Harga Eceran Tertinggi: batas ATAS harga per kategori per tanggal,
// ditetapkan Pemkab/Admin. Produsen tidak bisa menjual di atas nilai ini.
// Catatan desain: HET melindungi KONSUMEN (batas atas). Untuk melindungi
// PRODUSEN dipakai floorPrice (batas bawah) opsional.
model HetPrice {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  maxPrice    Int // rupiah / satuan
  floorPrice  Int? // batas bawah (lindungi produsen) — opsional
  effectiveOn DateTime // berlaku untuk tanggal ini
  setById     String
  setBy       User     @relation("HetSetBy", fields: [setById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([categoryId, effectiveOn])
  @@index([effectiveOn])
}

model Product {
  id          String          @id @default(cuid())
  producerId  String
  producer    ProducerProfile @relation(fields: [producerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  name        String
  unit        String
  price       Int // rupiah / satuan — DIVALIDASI <= HET aktif saat simpan
  stock       Int             @default(0)
  // Waktu panen DIDEKLARASIKAN produsen (self-reported). Ditampilkan apa adanya
  // di halaman traceability; bukan klaim terverifikasi independen.
  harvestedAt DateTime
  photoUrl    String?
  active      Boolean         @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
  @@index([producerId])
}

// ------------------------------------------------------------------
// Order + Escrow
// ------------------------------------------------------------------

enum OrderStatus {
  MENUNGGU_BAYAR // dibuat, belum dibayar
  DIBAYAR // dana masuk escrow (HELD)
  DIJEMPUT_KURIR // kurir ditugaskan & menuju produsen
  DIKIRIM // barang diambil, dalam perjalanan
  DITERIMA // sampai; grace period 2 jam dimulai
  SELESAI // grace lewat tanpa komplain → dana RELEASED ke produsen
  SENGKETA // ada komplain → menunggu keputusan
  DIBATALKAN // batal sebelum dibayar
  REFUND // komplain valid → dana dikembalikan ke konsumen
}

enum EscrowStatus {
  NONE
  HELD // dana ditahan payment gateway
  RELEASED // diteruskan ke produsen
  REFUNDED // dikembalikan ke konsumen
}

model Order {
  id             String       @id @default(cuid())
  consumerId     String
  consumer       User         @relation("ConsumerOrders", fields: [consumerId], references: [id])
  courierId      String?
  courier        CourierProfile? @relation("CourierOrders", fields: [courierId], references: [id])
  status         OrderStatus  @default(MENUNGGU_BAYAR)
  channel        Channel      @default(B2C)

  subtotal       Int
  deliveryFee    Int
  total          Int

  escrowStatus   EscrowStatus @default(NONE)
  paymentRef     String? // referensi dari payment gateway
  gracePeriodEnd DateTime? // batas akhir grace period saat status DITERIMA

  // Alamat antar (koordinat konsumen untuk hitung ongkir)
  addressText    String
  destLat        Float?
  destLng        Float?

  items          OrderItem[]
  complaint      Complaint?
  events         OrderEvent[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([consumerId])
  @@index([courierId])
}

enum Channel {
  B2C
  B2B
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  qty         Int
  unitPrice   Int // harga saat transaksi (snapshot)
  lineTotal   Int
  // Snapshot data traceability pada saat order dibuat.
  traceCode   String   @unique // dipakai di URL publik /trace/[code]
  harvestedAt DateTime
  producerLat Float?
  producerLng Float?
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ------------------------------------------------------------------
// Komplain / garansi kesegaran
// ------------------------------------------------------------------

enum ComplaintStatus {
  BARU
  DITINJAU
  VALID // → refund
  DITOLAK
}

model Complaint {
  id           String          @id @default(cuid())
  orderId      String          @unique
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User            @relation(fields: [reporterId], references: [id])
  reason       String
  evidenceUrls String[] // foto/video bukti
  status       ComplaintStatus @default(BARU)
  reviewNote   String?
  createdAt    DateTime        @default(now())
}
