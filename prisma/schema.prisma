// G-Fresh — skema data MVP (fase pilot)
// Postgres (Supabase). URL pooled untuk runtime, DIRECT_URL untuk migrate/db push.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------
// Peran & pengguna
// ------------------------------------------------------------------

enum Role {
  PRODUSEN // petani / petambak / peternak / UMKM olahan
  KONSUMEN // rumah tangga B2C & vendor katering B2B
  KURIR // mitra logistik hyperlocal
  ADMIN // operator aplikasi (badan usaha swasta)
  PEMKAB // dinas terkait — read-only dashboard agregat
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String // bcrypt hash — BUKAN enkripsi reversibel
  role         Role
  kecamatan    String? // wilayah pilot (mis. "Kebomas", "Manyar", "Cerme")
  defaultAddress String? // alamat tersimpan konsumen (prefill checkout)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  producer     ProducerProfile?
  courier      CourierProfile?
  orders       Order[]          @relation("ConsumerOrders")
  complaints   Complaint[]
  hetSet        HetPrice[]      @relation("HetSetBy")
  notifications Notification[]
  business      BusinessProfile?

  @@index([role])
}

model ProducerProfile {
  id          String            @id @default(cuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName    String
  kecamatan   String
  // Koordinat lokasi produksi. Disimpan penuh untuk pickup kurir,
  // tapi HANYA level kecamatan yang diekspos ke publik (privasi produsen).
  latitude    Float?
  longitude   Float?
  // Sertifikasi diverifikasi MANUAL oleh dinas pada fase pilot.
  certStatus  CertStatus        @default(BELUM_DIAJUKAN)
  certType    String? // "Halal" | "P-IRT" | "BPOM"
  certNote    String?
  ratingScore Float             @default(5)
  products    Product[]
  createdAt   DateTime          @default(now())
}

enum CertStatus {
  BELUM_DIAJUKAN
  MENUNGGU_VERIFIKASI
  TERVERIFIKASI
  DITOLAK
}

model CourierProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kecamatan   String
  vehicle     String? // "Motor + cool-box"
  ktpVerified Boolean  @default(false)
  active      Boolean  @default(true)
  ratingScore Float    @default(5)
  orders      Order[]  @relation("CourierOrders")
  createdAt   DateTime @default(now())
}

// ------------------------------------------------------------------
// Katalog & HET
// ------------------------------------------------------------------

// ------------------------------------------------------------------
// #6 Notifikasi in-app (tanpa gateway eksternal)
// ------------------------------------------------------------------

enum NotifKind {
  ORDER      // perubahan status pesanan
  KOMPLAIN   // siklus komplain / sengketa
  AKUN       // verifikasi, sanksi, sertifikasi
  TAGIHAN    // invoice B2B
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotifKind @default(ORDER)
  title     String
  body      String
  href      String? // tautan tujuan saat diklik
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique // "Sayur", "Ikan", "Daging Ayam", "Beras"
  unit     String // satuan default: "kg", "ikat", "ekor"
  products Product[]
  het      HetPrice[]
}

// Harga Eceran Tertinggi: batas ATAS harga per kategori per tanggal,
// ditetapkan Pemkab/Admin. Produsen tidak bisa menjual di atas nilai ini.
// Catatan desain: HET melindungi KONSUMEN (batas atas). Untuk melindungi
// PRODUSEN dipakai floorPrice (batas bawah) opsional.
model HetPrice {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  maxPrice    Int // rupiah / satuan
  floorPrice  Int? // batas bawah (lindungi produsen) — opsional
  effectiveOn DateTime // berlaku untuk tanggal ini
  setById     String
  setBy       User     @relation("HetSetBy", fields: [setById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([categoryId, effectiveOn])
  @@index([effectiveOn])
}

// ------------------------------------------------------------------
// #8 Kanal B2B — mesin lintas-subsidi (platform fee 2,5%)
// ------------------------------------------------------------------

model BusinessProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String
  businessType String // "Katering", "Restoran", "Hotel", "Retail"
  npwp         String?
  picName      String
  picPhone     String
  billingAddress String
  verified     Boolean  @default(false) // diverifikasi admin sebelum boleh nego volume
  createdAt    DateTime @default(now())
}

enum InvoiceStatus {
  BELUM_DIBAYAR
  LUNAS
  JATUH_TEMPO
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique // GF/B2B/2026/0001
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subtotal    Int
  deliveryFee Int
  platformFee Int // pendapatan operator (2,5% dari subtotal)
  total       Int
  status      InvoiceStatus @default(BELUM_DIBAYAR)
  issuedAt    DateTime      @default(now())
  dueDate     DateTime // termin pembayaran (net 14 hari)
  paidAt      DateTime?

  @@index([status])
}

model Product {
  id          String          @id @default(cuid())
  producerId  String
  producer    ProducerProfile @relation(fields: [producerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  name        String
  unit        String
  price       Int // rupiah / satuan — DIVALIDASI <= HET aktif saat simpan
  stock       Int             @default(0)
  // Harga grosir B2B — berlaku bila qty >= b2bMinQty. Tetap divalidasi terhadap HET.
  b2bPrice    Int?
  b2bMinQty   Int?
  // Waktu panen DIDEKLARASIKAN produsen (self-reported). Ditampilkan apa adanya
  // di halaman traceability; bukan klaim terverifikasi independen.
  harvestedAt DateTime
  photoUrl    String?
  active      Boolean         @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
  @@index([producerId])
}

// ------------------------------------------------------------------
// Order + Escrow
// ------------------------------------------------------------------

enum OrderStatus {
  MENUNGGU_BAYAR // dibuat, belum dibayar
  DIBAYAR // dana masuk escrow (HELD)
  DIJEMPUT_KURIR // kurir ditugaskan & menuju produsen
  DIKIRIM // barang diambil, dalam perjalanan
  DITERIMA // sampai; grace period 2 jam dimulai
  SELESAI // grace lewat tanpa komplain → dana RELEASED ke produsen
  SENGKETA // ada komplain → menunggu keputusan
  DIBATALKAN // batal sebelum dibayar
  REFUND // komplain valid → dana dikembalikan ke konsumen
  REFUND_SEBAGIAN // komplain sebagian valid → sebagian dana dikembalikan
}

enum EscrowStatus {
  NONE
  HELD // dana ditahan payment gateway
  RELEASED // diteruskan ke produsen
  REFUNDED // dikembalikan ke konsumen
}

model Order {
  id             String       @id @default(cuid())
  consumerId     String
  consumer       User         @relation("ConsumerOrders", fields: [consumerId], references: [id])
  courierId      String?
  courier        CourierProfile? @relation("CourierOrders", fields: [courierId], references: [id])
  status         OrderStatus  @default(MENUNGGU_BAYAR)
  channel        Channel      @default(B2C)

  subtotal       Int
  deliveryFee    Int
  total          Int

  escrowStatus   EscrowStatus @default(NONE)
  refundAmount   Int?         // nominal yang dikembalikan (untuk refund sebagian)
  platformFee    Int          @default(0) // #8: fee operator, hanya pada kanal B2B
  paymentRef     String? // referensi dari payment gateway
  gracePeriodEnd DateTime? // batas akhir grace period saat status DITERIMA

  // Alamat antar (koordinat konsumen untuk hitung ongkir)
  addressText    String
  destLat        Float?
  destLng        Float?

  items          OrderItem[]
  complaint      Complaint?
  invoice        Invoice?
  events         OrderEvent[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([consumerId])
  @@index([courierId])
}

enum Channel {
  B2C
  B2B
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  qty         Int
  unitPrice   Int // harga saat transaksi (snapshot)
  lineTotal   Int
  // Snapshot data traceability pada saat order dibuat.
  traceCode   String   @unique // dipakai di URL publik /trace/[code]
  harvestedAt DateTime
  producerLat Float?
  producerLng Float?
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ------------------------------------------------------------------
// Komplain / garansi kesegaran
// ------------------------------------------------------------------

enum ComplaintStatus {
  MENUNGGU_SANGGAHAN // produsen diberi kesempatan menanggapi (SLA 12 jam)
  DITINJAU           // dieskalasi ke admin (produsen menolak / tidak merespon)
  VALID              // → refund ke konsumen
  DITOLAK            // → dana diteruskan ke produsen
}

// Sikap produsen atas komplain konsumen (hak sanggah).
enum ProducerStance {
  BELUM_MERESPON
  SETUJU // mengakui — refund diproses langsung tanpa admin
  TOLAK  // menyanggah — dieskalasi ke admin dengan bukti tandingan
}

model Complaint {
  id           String          @id @default(cuid())
  orderId      String          @unique
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User            @relation(fields: [reporterId], references: [id])
  reason       String
  evidenceUrls String[] // foto/video bukti dari konsumen
  status       ComplaintStatus @default(MENUNGGU_SANGGAHAN)
  reviewNote   String? // catatan keputusan admin

  // --- Hak sanggah produsen ---
  producerStance     ProducerStance @default(BELUM_MERESPON)
  producerResponse   String? // alasan/sanggahan produsen
  producerEvidence   String[] // bukti tandingan dari produsen
  producerRespondedAt DateTime?
  responseDeadline   DateTime? // batas waktu sanggah produsen; lewat = eskalasi ke admin
  adminDeadline      DateTime? // batas waktu admin memutus; lewat = auto-refund ke konsumen

  // --- #7 Penilaian risiko penyalahgunaan klaim (dihitung saat komplain dibuat) ---
  riskScore    Int      @default(0) // 0-100; makin tinggi makin patut dicurigai
  riskFlags    String[] // penanda pola: RASIO_TINGGI, MENIT_AKHIR, KLAIM_BERULANG, dst

  createdAt    DateTime        @default(now())
}
