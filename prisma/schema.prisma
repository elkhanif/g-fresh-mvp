// G-Fresh — skema data MVP (fase pilot)
// Postgres (Supabase). URL pooled untuk runtime, DIRECT_URL untuk migrate/db push.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------
// Peran & pengguna
// ------------------------------------------------------------------

enum Role {
  PRODUSEN // petani / petambak / peternak / UMKM olahan
  KONSUMEN // rumah tangga B2C & vendor katering B2B
  KURIR // mitra logistik hyperlocal
  ADMIN // operator aplikasi (badan usaha swasta)
  PEMKAB // dinas terkait — read-only dashboard agregat
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String // bcrypt hash — BUKAN enkripsi reversibel
  role         Role
  kecamatan    String? // wilayah pilot (mis. "Kebomas", "Manyar", "Cerme")
  defaultAddress String? // alamat tersimpan konsumen (prefill checkout)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  producer     ProducerProfile?
  courier      CourierProfile?
  orders       Order[]          @relation("ConsumerOrders")
  complaints   Complaint[]
  hetSet        HetPrice[]      @relation("HetSetBy")
  notifications Notification[]
  business      BusinessProfile?

  @@index([role])
}

/// Tipe penjual. Membedakan dua jalur pasok di poster: pedagang pasar
/// tradisional yang terdaftar Diskoperindag, versus petani/petambak yang
/// menjual langsung dari lahan.
enum SellerType {
  TANI // lumbung tani & tambak — direct farm-to-table
  PASAR // pedagang kios di pasar rakyat
}

/// Pasar rakyat Kabupaten Gresik. Daftar awalnya mengikuti tujuh pasar yang
/// terdaftar di portal SIBAPO Diskoperindag, sehingga `slug` bisa dipakai
/// sebagai tujuan deep-link dari portal tersebut: /pasar/giri.
model Market {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  kecamatan String
  address   String
  latitude  Float?
  longitude Float?
  active    Boolean  @default(true)
  producers ProducerProfile[]
  createdAt DateTime @default(now())
}

model ProducerProfile {
  id          String            @id @default(cuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName    String
  kecamatan   String
  // Jalur pasok penjual ini. Pedagang pasar mengisi `market` + `kioskName`;
  // petani/petambak membiarkannya kosong.
  sellerType  SellerType        @default(TANI)
  marketId    String?
  market      Market?           @relation(fields: [marketId], references: [id])
  kioskName   String? // mis. "Kios Bu Siti - Blok A"
  // Koordinat lokasi produksi. Disimpan penuh untuk pickup kurir,
  // tapi HANYA level kecamatan yang diekspos ke publik (privasi produsen).
  latitude    Float?
  longitude   Float?
  // Sertifikasi diverifikasi MANUAL oleh dinas pada fase pilot.
  certStatus  CertStatus        @default(BELUM_DIAJUKAN)
  certType    String? // "Halal" | "P-IRT" | "BPOM"
  certNote    String? // catatan/alasan keputusan terakhir dinas
  // Bukti sertifikat yang diajukan produsen. Nomor wajib saat mengajukan;
  // dokumen (scan/foto/PDF) opsional — banyak produsen kecil belum punya
  // salinan digital, dan memaksakannya akan mengunci mereka dari sistem.
  certNumber      String?
  certIssuer      String? // penerbit: Dinkes, BPJPH, BPOM, dst
  certIssuedAt    DateTime?
  certExpiresAt   DateTime? // P-IRT 5 th, Halal 4 th — dipantau cron
  certDocUrl      String?
  certSubmittedAt DateTime?
  certReviewedAt  DateTime?
  certReviews     CertReview[]
  ratingScore Float             @default(5)
  products    Product[]
  createdAt   DateTime          @default(now())
}

// Jejak keputusan sertifikasi. Append-only: setiap pengajuan, verifikasi,
// permintaan perbaikan, penolakan, dan pencabutan menghasilkan satu baris.
// Ini keputusan instansi pemerintah yang menutup/membuka akses ekonomi
// seseorang — nilai akhirnya saja tidak cukup, harus bisa ditelusuri.
model CertReview {
  id         String   @id @default(cuid())
  producerId String
  producer   ProducerProfile @relation(fields: [producerId], references: [id], onDelete: Cascade)
  fromStatus CertStatus
  toStatus   CertStatus
  certType   String?
  certNumber String?
  note       String?
  actorId    String? // null = sistem (mis. penandaan kedaluwarsa oleh cron)
  actorName  String? // disalin saat kejadian; nama petugas tetap terbaca
  createdAt  DateTime @default(now())

  @@index([producerId, createdAt])
}

enum CertStatus {
  BELUM_DIAJUKAN
  MENUNGGU_VERIFIKASI
  MENUNGGU_PERBAIKAN // dikembalikan ke produsen dengan catatan perbaikan
  TERVERIFIKASI
  DITOLAK
  KEDALUWARSA // masa berlaku lewat; ditandai otomatis oleh cron
  DICABUT // dicabut dinas setelah sempat terbit
}

model CourierProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kecamatan   String
  vehicle     String? // "Motor + cool-box"

  // --- Verifikasi KTP (KYC) ---
  ktpNumber        String?   // NIK 16 digit, diajukan kurir sendiri
  ktpPhotoUrl      String?   // foto KTP yang diunggah kurir
  ktpSubmittedAt   DateTime? // kapan pengajuan/pengajuan-ulang terakhir dikirim
  ktpVerified      Boolean   @default(false)
  ktpRejectedReason String?  // diisi admin bila menolak; kurir bisa ajukan ulang

  active      Boolean  @default(true)
  ratingScore Float    @default(5)
  orders      Order[]  @relation("CourierOrders")
  wallet      WalletTx[]
  toolkit     ToolkitPlan?
  createdAt   DateTime @default(now())
}

enum WalletTxKind {
  ONGKIR // upah antar, masuk saat pesanan selesai
  POTONGAN_ALAT // angsuran harian coolbox
  PENARIKAN // ditarik kurir ke rekening
  PENYESUAIAN // koreksi manual admin
}

/// Buku besar dompet kurir. Append-only: SALDO TIDAK DISIMPAN sebagai kolom,
/// melainkan hasil penjumlahan seluruh baris. Menyimpan saldo sekaligus
/// riwayatnya berarti dua sumber kebenaran untuk uang yang sama — dan itu
/// cara tercepat menciptakan selisih yang tidak bisa dijelaskan.
model WalletTx {
  id        String       @id @default(cuid())
  courierId String
  courier   CourierProfile @relation(fields: [courierId], references: [id], onDelete: Cascade)
  kind      WalletTxKind
  amount    Int // positif = masuk, negatif = keluar
  note      String?
  orderId   String? // diisi untuk ONGKIR
  createdAt DateTime     @default(now())

  // Satu order hanya boleh menghasilkan satu baris ongkir. Penjaga di level
  // basis data, bukan cuma di kode: kalau cron berjalan dua kali, baris kedua
  // ditolak Postgres alih-alih menggandakan upah.
  @@unique([orderId, kind])
  @@index([courierId, createdAt])
}

/// Skema perlengkapan kerja (coolbox): dibayar bertahap lewat potongan harian
/// dari dompet, bukan pinjaman tunai. Setelah lunas, alat jadi milik kurir.
model ToolkitPlan {
  id           String   @id @default(cuid())
  courierId    String   @unique
  courier      CourierProfile @relation(fields: [courierId], references: [id], onDelete: Cascade)
  itemName     String   @default("Coolbox G-Fresh")
  totalAmount  Int      @default(350000)
  dailyAmount  Int      @default(10000)
  tenorDays    Int      @default(35)
  paidDays     Int      @default(0)
  // Potongan hanya berjalan pada hari kurir benar-benar bekerja; kolom ini
  // mencegah pemotongan dua kali dalam satu hari.
  lastChargeOn DateTime?
  startedAt    DateTime @default(now())
  settledAt    DateTime?

  @@index([courierId])
}

// ------------------------------------------------------------------
// Wilayah layanan (kecamatan pilot) — dikelola Admin, bukan hardcoded.
// Menentukan pilihan kecamatan yang muncul saat pendaftaran. Pilot dimulai
// dari sebagian kecamatan; Admin bisa memperluas cakupan tanpa deploy ulang.
// ------------------------------------------------------------------

model ServiceArea {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------------
// Katalog & HET
// ------------------------------------------------------------------

// ------------------------------------------------------------------
// #6 Notifikasi in-app (tanpa gateway eksternal)
// ------------------------------------------------------------------

enum NotifKind {
  ORDER      // perubahan status pesanan
  KOMPLAIN   // siklus komplain / sengketa
  AKUN       // verifikasi, sanksi, sertifikasi
  TAGIHAN    // invoice B2B
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotifKind @default(ORDER)
  title     String
  body      String
  href      String? // tautan tujuan saat diklik
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique // "Sayur", "Ikan", "Daging Ayam", "Beras"
  unit     String // satuan default: "kg", "ikat", "ekor"
  products Product[]
  het      HetPrice[]
}

// Harga Eceran Tertinggi: batas ATAS harga per kategori per tanggal,
// ditetapkan Pemkab/Admin. Produsen tidak bisa menjual di atas nilai ini.
// Catatan desain: HET melindungi KONSUMEN (batas atas). Untuk melindungi
// PRODUSEN dipakai floorPrice (batas bawah) opsional.
model HetPrice {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  maxPrice    Int // rupiah / satuan
  floorPrice  Int? // batas bawah (lindungi produsen) — opsional
  effectiveOn DateTime // berlaku untuk tanggal ini
  setById     String
  setBy       User     @relation("HetSetBy", fields: [setById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([categoryId, effectiveOn])
  @@index([effectiveOn])
}

// ------------------------------------------------------------------
// #8 Kanal B2B — mesin lintas-subsidi (platform fee 2,5%)
// ------------------------------------------------------------------

model BusinessProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String
  businessType String // "Katering", "Restoran", "Hotel", "Retail"
  npwp         String?
  picName      String
  picPhone     String
  billingAddress String
  verified     Boolean  @default(false) // diverifikasi admin sebelum boleh nego volume
  createdAt    DateTime @default(now())
}

enum InvoiceStatus {
  BELUM_DIBAYAR
  LUNAS
  JATUH_TEMPO
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique // GF/B2B/2026/0001
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subtotal    Int
  deliveryFee Int
  platformFee Int // pendapatan operator (2,5% dari subtotal)
  total       Int
  status      InvoiceStatus @default(BELUM_DIBAYAR)
  issuedAt    DateTime      @default(now())
  dueDate     DateTime // termin pembayaran (net 14 hari)
  paidAt      DateTime?

  @@index([status])
}

model Product {
  id          String          @id @default(cuid())
  producerId  String
  producer    ProducerProfile @relation(fields: [producerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  name        String
  unit        String
  price       Int // rupiah / satuan — DIVALIDASI <= HET aktif saat simpan
  stock       Int             @default(0)
  // Harga grosir B2B — berlaku bila qty >= b2bMinQty. Tetap divalidasi terhadap HET.
  b2bPrice    Int?
  b2bMinQty   Int?
  // Waktu panen DIDEKLARASIKAN produsen (self-reported). Ditampilkan apa adanya
  // di halaman traceability; bukan klaim terverifikasi independen.
  harvestedAt DateTime
  photoUrl    String?
  active      Boolean         @default(true)
  orderItems  OrderItem[]
  priceHistory   PriceHistory[]
  stockMovements StockMovement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
  @@index([producerId])
}

// ------------------------------------------------------------------
// Riwayat harga & mutasi stok — produsen mengubah produk yang sudah tayang
// ------------------------------------------------------------------

// Setiap perubahan harga DICATAT, bukan menimpa. Alasan desain: harga pangan
// itu data yang diawasi (HET, dugaan permainan harga), jadi yang penting
// bukan cuma nilai terakhir tapi jejak perubahannya.
model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice    Int
  newPrice    Int
  oldB2bPrice Int?
  newB2bPrice Int?
  // Snapshot HET yang berlaku SAAT perubahan. HET bisa berubah kemudian dan
  // membuat harga lama terlihat "melanggar" padahal saat itu sah.
  hetMaxAt    Int?
  hetFloorAt  Int?
  note        String?
  actorId     String? // produsen yang mengubah; null = sistem/seed
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
}

// Alasan mutasi stok. Empat pertama dipilih produsen secara manual;
// PENJUALAN_APP hanya ditulis sistem saat checkout mereservasi stok.
enum StockReason {
  RESTOCK // panen / pasok baru masuk
  TERJUAL_MANUAL // terjual di luar aplikasi (pasar, langganan langsung)
  RUSAK // susut / busuk / rusak
  KOREKSI // pembetulan salah input
  PENJUALAN_APP // otomatis: reservasi stok saat checkout
}

// Buku besar stok: stok produk = hasil akumulasi mutasi ini. Disimpan
// eksplisit (before/after) supaya selisih terlihat walau ada koreksi manual.
model StockMovement {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int // positif = masuk, negatif = keluar
  before    Int
  after     Int
  reason    StockReason
  note      String?
  orderId   String? // diisi untuk PENJUALAN_APP
  actorId   String? // null = sistem
  createdAt DateTime    @default(now())

  @@index([productId, createdAt])
}

// ------------------------------------------------------------------
// Order + Escrow
// ------------------------------------------------------------------

enum OrderStatus {
  MENUNGGU_BAYAR // dibuat, belum dibayar
  DIBAYAR // dana masuk escrow (HELD)
  DIJEMPUT_KURIR // kurir ditugaskan & menuju produsen
  DIKIRIM // barang diambil, dalam perjalanan
  DITERIMA // sampai; grace period 2 jam dimulai
  SELESAI // grace lewat tanpa komplain → dana RELEASED ke produsen
  SENGKETA // ada komplain → menunggu keputusan
  DIBATALKAN // batal sebelum dibayar
  REFUND // komplain valid → dana dikembalikan ke konsumen
  REFUND_SEBAGIAN // komplain sebagian valid → sebagian dana dikembalikan
}

enum EscrowStatus {
  NONE
  HELD // dana ditahan payment gateway
  RELEASED // diteruskan ke produsen
  REFUNDED // dikembalikan ke konsumen
}

model Order {
  id             String       @id @default(cuid())
  consumerId     String
  consumer       User         @relation("ConsumerOrders", fields: [consumerId], references: [id])
  courierId      String?
  courier        CourierProfile? @relation("CourierOrders", fields: [courierId], references: [id])
  status         OrderStatus  @default(MENUNGGU_BAYAR)
  channel        Channel      @default(B2C)

  subtotal       Int
  deliveryFee    Int
  total          Int

  escrowStatus   EscrowStatus @default(NONE)
  refundAmount   Int?         // nominal yang dikembalikan (untuk refund sebagian)
  platformFee    Int          @default(0) // #8: fee operator, hanya pada kanal B2B
  paymentRef     String? // referensi dari payment gateway
  gracePeriodEnd DateTime? // batas akhir grace period saat status DITERIMA

  // Alamat antar (koordinat konsumen untuk hitung ongkir)
  addressText    String
  destLat        Float?
  destLng        Float?

  items          OrderItem[]
  complaint      Complaint?
  invoice        Invoice?
  events         OrderEvent[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([consumerId])
  @@index([courierId])
}

enum Channel {
  B2C
  B2B
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  qty         Int
  unitPrice   Int // harga saat transaksi (snapshot)
  lineTotal   Int
  // Snapshot data traceability pada saat order dibuat.
  traceCode   String   @unique // dipakai di URL publik /trace/[code]
  harvestedAt DateTime
  producerLat Float?
  producerLng Float?
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ------------------------------------------------------------------
// Komplain / garansi kesegaran
// ------------------------------------------------------------------

enum ComplaintStatus {
  MENUNGGU_SANGGAHAN   // produsen belum/harus merespon (awal, atau setelah tawaran ditolak)
  MENUNGGU_PERSETUJUAN // ada tawaran refund sebagian aktif, menunggu keputusan konsumen
  DITINJAU             // dieskalasi ke admin — keputusan admin bersifat final/mengikat
  VALID                // → refund (penuh atau sebagian) ke konsumen
  DITOLAK              // → dana diteruskan ke produsen
}

// Sikap produsen atas komplain konsumen (hak sanggah).
enum ProducerStance {
  BELUM_MERESPON
  SETUJU // mengakui penuh — refund 100% diproses langsung tanpa admin
  TAWAR  // mengakui sebagian — mengajukan nominal refund, menunggu persetujuan konsumen
  TOLAK  // menyanggah — dieskalasi ke admin dengan bukti tandingan
}

// Kategori keluhan terstruktur. Dipakai untuk saran nominal refund otomatis
// (KURANG_TIMBANGAN) dan supaya alasan komplain tidak melulu teks bebas.
enum ComplaintCategory {
  KURANG_TIMBANGAN // jumlah/berat yang diterima kurang dari yang dipesan
  RUSAK            // rusak/hancur dalam perjalanan
  TIDAK_SEGAR      // kualitas/kesegaran tidak sesuai
  SALAH_PRODUK     // barang tidak sesuai yang dipesan
  LAINNYA
}

enum OfferStatus {
  MENUNGGU
  DITERIMA
  DITOLAK
}

model Complaint {
  id           String          @id @default(cuid())
  orderId      String          @unique
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User            @relation(fields: [reporterId], references: [id])
  category     ComplaintCategory @default(LAINNYA)
  qtyAffected  Float?          // jumlah unit yang bermasalah (skala sama dengan unit produk)
  reason       String
  evidenceUrls String[] // foto/video bukti dari konsumen
  status       ComplaintStatus @default(MENUNGGU_SANGGAHAN)
  reviewNote   String? // catatan keputusan admin

  // Saran nominal refund otomatis (KURANG_TIMBANGAN): proporsional terhadap
  // qtyAffected / qty item. Murni starting point, tidak mengikat siapa pun.
  suggestedRefund Int?

  // --- Hak sanggah & negosiasi produsen ---
  producerStance     ProducerStance @default(BELUM_MERESPON)
  producerResponse   String? // alasan/sanggahan produsen
  producerEvidence   String[] // bukti tandingan dari produsen
  producerRespondedAt DateTime?
  responseDeadline   DateTime? // batas waktu produsen merespon; lewat = eskalasi ke admin
  adminDeadline      DateTime? // batas waktu admin memutus; lewat = auto-refund ke konsumen
  round              Int      @default(0) // jumlah putaran tawaran yang sudah terjadi
  offers             ComplaintOffer[]

  // --- #7 Penilaian risiko penyalahgunaan klaim (dihitung saat komplain dibuat) ---
  riskScore    Int      @default(0) // 0-100; makin tinggi makin patut dicurigai
  riskFlags    String[] // penanda pola: RASIO_TINGGI, MENIT_AKHIR, KLAIM_BERULANG, dst

  createdAt    DateTime        @default(now())
}

// Satu putaran tawaran refund sebagian dari produsen ke konsumen.
// Riwayat lengkap disimpan (bukan ditimpa) agar admin punya jejak negosiasi
// yang jelas ketika kasus akhirnya dieskalasi.
model ComplaintOffer {
  id          String      @id @default(cuid())
  complaintId String
  complaint   Complaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  round       Int         // ke berapa tawaran ini dalam siklus negosiasi (1, 2, 3, …)
  amount      Int         // nominal refund yang ditawarkan produsen
  note        String?
  status      OfferStatus @default(MENUNGGU)
  createdAt   DateTime    @default(now())
  respondedAt DateTime?

  @@index([complaintId])
}
