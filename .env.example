# ---- Database (Supabase / PostgreSQL) ----
# Pooled connection (pgBouncer) for the app at runtime:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection for prisma migrate / db push:
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---- NextAuth ----
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---- Traceability signing (HMAC untuk token QR) ----
TRACE_SECRET="ganti-dengan-random-string-lain"

# ---- Payment gateway (Midtrans-shaped). Kosongkan = mode simulasi. ----
PAYMENT_PROVIDER="mock"           # mock | midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# ---- Notifikasi WA/OTP. Kosongkan = log ke console. ----
NOTIFY_PROVIDER="mock"            # mock | wa
WA_GATEWAY_URL=""
WA_GATEWAY_TOKEN=""

# Akar penyimpanan berkas PRIVAT (foto KTP, salinan sertifikat, bukti komplain).
# Default: <root project>/private-uploads. WAJIB di luar public/ — kalau folder
# ini bisa dilayani sebagai aset statis, seluruh kontrol aksesnya batal.
# PRIVATE_UPLOAD_DIR="/var/lib/gfresh/private-uploads"
