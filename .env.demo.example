# ============================================================
#  MODE DEMO LOKAL — salin jadi .env sebelum tampil
#  cp .env.demo.example .env
# ============================================================
# Simpan .env produksi (Neon) lebih dulu, mis. jadi .env.neon,
# supaya gampang dikembalikan setelah lomba selesai.

# ---- Database lokal (docker-compose.demo.yml) ----
# Port 5433, bukan 5432, supaya tidak bentrok dengan Postgres lain.
DATABASE_URL="postgresql://gfresh:gfresh_demo@localhost:5433/gfresh"
DIRECT_URL="postgresql://gfresh:gfresh_demo@localhost:5433/gfresh"

# ---- NextAuth ----
# Boleh nilai apa pun untuk demo lokal, asal tidak kosong.
NEXTAUTH_SECRET="demo-lokal-ganti-kalau-mau-aman"
NEXTAUTH_URL="http://localhost:3000"

# ---- Traceability (HMAC token QR) ----
TRACE_SECRET="demo-lokal-trace-secret"

# ---- Semua layanan luar dimatikan: demo harus jalan tanpa jaringan ----
PAYMENT_PROVIDER="mock"
NOTIFY_PROVIDER="mock"
STORAGE_PROVIDER="local"

# Kosongkan agar cron settle bisa dipanggil tanpa header Authorization
# saat demo (mempercepat peragaan pelepasan dana).
CRON_SECRET=""
